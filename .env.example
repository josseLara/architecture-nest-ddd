# Application
NODE_ENV=development
PORT=3000

# HTTP
API_PREFIX=api
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional: when set, every non-public route requires the x-api-key header
# API_KEY=change-me

# Mock persistence (JSON file). Relative paths resolve from the process cwd.
PAYMENTS_DATA_FILE=data/payments.json

# Docker Compose (host ports and Grafana admin credentials)
# Si el 3000 está ocupado (por ejemplo, un clúster kind), usá 3005.
SERVER_PORT=3000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
